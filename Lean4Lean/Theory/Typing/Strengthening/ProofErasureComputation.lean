import Lean4Lean.Theory.Typing.Strengthening.ProofErasureBeta
import Lean4Lean.Theory.Typing.Strengthening.PatternComputation

/-! # Compatible computation of annotated proof erasures

A primitive erased rule must replay from each typed original source. Compatible
closure and finite composition then replay automatically, including inside
annotations. Original pattern computation supplies syntactic scope reflection.
-/
namespace Lean4Lean.VEnv.Strengthening
open _root_.Lean4Lean _root_.Lean4Lean.VExpr Params
open PureObservation (Definitions PatternCompute)
open private erase_app_inv erase_proj_inv erase_lam_inv erase_forallE_inv
  from Lean4Lean.Theory.Typing.Strengthening.ProofErasureBeta

namespace ProofShape
/-- Compatible finite computation generated by erased primitive steps and beta. -/
inductive Compute (Step : ProofShape → ProofShape → Prop) : ProofShape → ProofShape → Prop where
  | base : Step e out → Compute Step e out
  | beta : BetaRed e out → Compute Step e out
  | trans : Compute Step a b → Compute Step b c → Compute Step a c
  | app : Compute Step f f' → Compute Step a a' → Compute Step (.app f a) (.app f' a')
  | proj : Compute Step m m' → Compute Step (.proj s i m) (.proj s i m')
  | lam : Compute Step A A' → Compute Step b b' → Compute Step (.lam A b) (.lam A' b')
  | forallE : Compute Step A A' → Compute Step B B' → Compute Step (.forallE A B) (.forallE A' B')

/-- Every erased term admits an empty computation. -/
theorem Compute.refl : Compute Step e e := .beta .refl
end ProofShape

variable [Params]
local notation:65 Γ " ⊢ " e " : " A:36 => HasType Params.env univs Γ e A

/-- Required replay property of primitive erased rules. No intermediate erased
term is assumed to have a typed representative; replay constructs it. -/
def ErasedPrimitiveReplay (D : Definitions) (Step : ProofShape → ProofShape → Prop) : Prop :=
  ∀ {Γ e T out}, OnCtx Γ (env.IsType univs) → (Γ ⊢ e : T) →
    Step (proofErase Γ e) out → ∃ e', PatternCompute D e e' ∧ proofErase Γ e' = out

private theorem compute_eq (hs : D.Sound env univs) (hΓ : OnCtx Γ (env.IsType univs))
    (he : Γ ⊢ e : T) (R : PatternCompute D e e') : env.IsDefEq univs Γ e e' T :=
  R.simAt hs hΓ T he

private theorem compute_not_proof (hs : D.Sound env univs) (hΓ : OnCtx Γ (env.IsType univs))
    (he : Γ ⊢ e : T) (R : PatternCompute D e e') (hn : ¬ IsProof Γ e) : ¬ IsProof Γ e' := by
  rintro ⟨P, heP, hP⟩
  exact hn ⟨P, ((show env.IsDefEqU univs Γ e' e from ⟨_, (compute_eq hs hΓ he R).symm⟩).of_l
    henv hΓ heP).hasType.2, hP⟩

/-- Primitive replay extends through every compatible finite erased computation. -/
theorem proofErase_compute_replay (hs : D.Sound env univs) (hstep : ErasedPrimitiveReplay D Step)
    (hΓ : OnCtx Γ (env.IsType univs)) (he : Γ ⊢ e : T)
    (R : ProofShape.Compute Step (proofErase Γ e) out) :
    ∃ e', PatternCompute D e e' ∧ proofErase Γ e' = out := by
  generalize hsrc : proofErase Γ e = source at R
  induction R generalizing Γ e T with
  | base R => exact hstep hΓ he (hsrc ▸ R)
  | beta R =>
    obtain ⟨e', R', H⟩ := proofErase_beta_replay hΓ he (hsrc ▸ R)
    exact ⟨e', .base (.base (.of_beta R')), H⟩
  | trans R1 R2 ih1 ih2 =>
    obtain ⟨e1, Re1, H1⟩ := ih1 hΓ he hsrc
    obtain ⟨e2, Re2, H2⟩ := ih2 hΓ (compute_eq hs hΓ he Re1).hasType.2 H1
    exact ⟨e2, Re1.trans Re2, H2⟩
  | app Rf Ra ihf iha =>
    obtain ⟨f, a, rfl, hn, Hf, Ha⟩ := erase_app_inv hsrc
    obtain ⟨_, _, hf, ha⟩ := he.app_inv henv hΓ
    obtain ⟨f', Rf', Hf'⟩ := ihf hΓ hf Hf
    obtain ⟨a', Ra', Ha'⟩ := iha hΓ ha Ha
    have R' := PatternCompute.app Rf' Ra'
    refine ⟨_, R', ?_⟩
    simp only [proofErase, if_neg (compute_not_proof hs hΓ he R' hn), Hf', Ha']
  | @proj m₁ m₂ s i Rm ihm =>
    obtain ⟨m, rfl, hn, Hm⟩ := erase_proj_inv hsrc
    obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, hm, _, _⟩ := he.proj_inv henv hΓ
    obtain ⟨m', Rm', Hm'⟩ := ihm hΓ hm.hasType.2 Hm
    have R' := PatternCompute.proj (s := s) (i := i) Rm'
    refine ⟨_, R', ?_⟩
    simp only [proofErase, if_neg (compute_not_proof hs hΓ he R' hn), Hm']
  | lam RA Rb ihA ihb =>
    obtain ⟨A, b, rfl, hn, HA, Hb⟩ := erase_lam_inv hsrc
    obtain ⟨⟨u, hA⟩, _, hb⟩ := he.lam_inv henv hΓ
    have hΓA : OnCtx (A :: Γ) (Params.env.IsType univs) := ⟨hΓ, u, hA⟩
    obtain ⟨A', RA', HA'⟩ := ihA hΓ hA HA
    obtain ⟨b', Rb', Hb'⟩ := ihb hΓA hb Hb
    have hAA := compute_eq hs hΓ hA RA'
    have hb' := (compute_eq hs hΓA hb Rb').hasType.2
    have Hb'' := (proofErase_defeqCtx hΓA (.succ .zero hAA) hb').symm.trans Hb'
    have R' := PatternCompute.lam RA' Rb'
    refine ⟨_, R', ?_⟩
    simp only [proofErase, if_neg (compute_not_proof hs hΓ he R' hn), HA', Hb'']
  | forallE RA RB ihA ihB =>
    obtain ⟨A, B, rfl, hn, HA, HB⟩ := erase_forallE_inv hsrc
    obtain ⟨⟨u, hA⟩, _, hB⟩ := he.forallE_inv henv
    have hΓA : OnCtx (A :: Γ) (Params.env.IsType univs) := ⟨hΓ, u, hA⟩
    obtain ⟨A', RA', HA'⟩ := ihA hΓ hA HA
    obtain ⟨B', RB', HB'⟩ := ihB hΓA hB HB
    have hAA := compute_eq hs hΓ hA RA'
    have hB' := (compute_eq hs hΓA hB RB').hasType.2
    have HB'' := (proofErase_defeqCtx hΓA (.succ .zero hAA) hB').symm.trans HB'
    have R' := PatternCompute.forallE RA' RB'
    refine ⟨_, R', ?_⟩
    simp only [proofErase, if_neg (compute_not_proof hs hΓ he R' hn), HA', HB'']

/-- A common erased computational target reflects at the originals' common type. -/
theorem proofErase_compute_join_reflect (hs : D.Sound env univs)
    (hstep : ErasedPrimitiveReplay D Step) (hΓ : OnCtx Γ (env.IsType univs))
    (ha : Γ ⊢ a : T) (hb : Γ ⊢ b : T)
    (Ra : ProofShape.Compute Step (proofErase Γ a) out)
    (Rb : ProofShape.Compute Step (proofErase Γ b) out) : env.IsDefEq univs Γ a b T := by
  obtain ⟨a', Ra', Ha⟩ := proofErase_compute_replay hs hstep hΓ ha Ra
  obtain ⟨b', Rb', Hb⟩ := proofErase_compute_replay hs hstep hΓ hb Rb
  have hAA := compute_eq hs hΓ ha Ra'
  have hBB := compute_eq hs hΓ hb Rb'
  obtain ⟨_, hT⟩ := ha.isType henv hΓ
  obtain ⟨_, HC⟩ := (proofErase_reflect hΓ hAA.hasType.2 hBB.hasType.2 (Ha.trans Hb.symm)).1 ⟨_, hT⟩
  exact hAA.trans (((HC.defeq hΓ).of_l henv hΓ hAA.hasType.2).trans hBB.symm)

/-- Erased computational joins of lifted sources descend. All intermediate
original typings and scope facts are reconstructed, not assumed. -/
theorem proofErase_compute_join_descend (hs : D.Sound env univs)
    (hstep : ErasedPrimitiveReplay D Step) (hΓ : OnCtx Γ (env.IsType univs))
    (hΓ' : OnCtx Γ' (env.IsType univs)) (W : Ctx.LiftN n k Γ Γ')
    (ha : Γ ⊢ a : T) (hb : Γ ⊢ b : T)
    (Ra : ProofShape.Compute Step (proofErase Γ' (a.liftN n k)) out)
    (Rb : ProofShape.Compute Step (proofErase Γ' (b.liftN n k)) out) :
    env.IsDefEq univs Γ a b T := by
  obtain ⟨a', Ra', Ha⟩ := proofErase_compute_replay hs hstep hΓ' (ha.weakN henv W) Ra
  obtain ⟨b', Rb', Hb⟩ := proofErase_compute_replay hs hstep hΓ' (hb.weakN henv W) Rb
  rw [← lift'_consN_skipN] at Ra' Rb'
  obtain ⟨a₀, RA, rfl⟩ := Ra'.lift_inv
  obtain ⟨b₀, RB, rfl⟩ := Rb'.lift_inv
  rw [lift'_consN_skipN] at Ha Hb
  have hAA := compute_eq hs hΓ ha RA
  have hBB := compute_eq hs hΓ hb RB
  obtain ⟨_, hT⟩ := ha.isType henv hΓ
  obtain ⟨_, HC⟩ := (proofErase_lift_reflect hΓ hΓ' W hAA.hasType.2 hBB.hasType.2
    (Ha.trans Hb.symm)).1 ⟨_, hT⟩
  exact hAA.trans (((HC.defeq hΓ).of_l henv hΓ hAA.hasType.2).trans hBB.symm)

end Lean4Lean.VEnv.Strengthening
