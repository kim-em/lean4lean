import Lean4Lean.Theory.Typing.Strengthening.ProofErasureTypedComputationDeclarations
import Lean4Lean.Theory.Typing.Strengthening.ProofErasureTypedBinderTransport

/-! # Normal equality as typed computation chains

The normal equality used in registered equation coverage is generated by
congruence, universe conversion, proof irrelevance and eta. All these operations
have chain constructions. Ordinary binder annotations are handled by generic eta
and context conversion, without any type-fork joining assumption.
-/
namespace Lean4Lean.VEnv.Strengthening
open _root_.Lean4Lean _root_.Lean4Lean.VExpr Params
variable [Params] {D : PureObservation.Definitions}

/-- Every bounded normal comparison has a typed computation chain at some
common assignment. This includes extensional comparison and arbitrary ordinary
conversion of lambda annotations and body contexts. -/
theorem normal_computation_chain_exists
    (heq : env.HasCanonicalEq) (hs : D.Sound env univs)
    (hΓ : OnCtx Γ (env.IsType univs)) (H : NormalEqN mode n Γ a b) :
    ∃ A, TypedComputationEq D Γ a b A := by
  induction H with
  | refl ht => exact ⟨_, .refl ht⟩
  | sortDF hu hv H => exact ⟨_, .sortDF hΓ hu hv H⟩
  | constDF hc hw hw' hl HE => exact ⟨_, .constDF hΓ hc hw hw' hl HE⟩
  | appDF hf _ hx _ _ _ ihf ihx =>
    obtain ⟨_, HF⟩ := ihf hΓ
    obtain ⟨_, HX⟩ := ihx hΓ
    exact ⟨_, .app hΓ (HF.at_source_type hΓ hf) (HX.at_source_type hΓ hx)⟩
  | projDF ht _ ih =>
    obtain ⟨_, HM⟩ := ih hΓ
    exact ⟨_, HM.proj hΓ ht⟩
  | lamDF HA HA' _ ih =>
    obtain ⟨_, HB⟩ := ih ⟨hΓ, _, HA.hasType.1⟩
    have HL := TypedComputationEq.lam_ordinary_domain heq hs hΓ HA (.refl HB.defeq.hasType.1)
    have HR := TypedComputationEq.lam_ordinary_domain heq hs hΓ HA' HB
    exact ⟨_, HL.symm.trans HR⟩
  | forallEDF HA _ hb _ ihA ihB =>
    obtain ⟨_, HD⟩ := ihA hΓ
    have hΓA : OnCtx (_ :: _) (env.IsType univs) := ⟨hΓ, _, HA.hasType.1⟩
    obtain ⟨_, HB⟩ := ihB hΓA
    have HB := (HB.at_source_type hΓA hb).defeqCtx heq hs hΓ (IsDefEqCtx.succ .zero HA)
    exact ⟨_, .forallE hΓ (HD.at_source_type hΓ HA.hasType.2) HB⟩
  | etaL hf _ ih =>
    obtain ⟨_, hPi⟩ := hf.isType henv hΓ
    obtain ⟨⟨u, hA⟩, _⟩ := hPi.forallE_inv henv
    obtain ⟨_, HB⟩ := ih ⟨hΓ, u, hA⟩
    have HL := HB.lam_body hΓ hA
    have HE := (TypedComputationEq.eta heq hs hΓ hf).symm
    exact ⟨_, HL.trans (HE.at_source_type hΓ HL.defeq.hasType.2)⟩
  | etaR hf _ ih =>
    obtain ⟨_, hPi⟩ := hf.isType henv hΓ
    obtain ⟨⟨u, hA⟩, _⟩ := hPi.forallE_inv henv
    obtain ⟨_, HB⟩ := ih ⟨hΓ, u, hA⟩
    have HE := TypedComputationEq.eta heq hs hΓ hf
    exact ⟨_, HE.trans ((HB.lam_body hΓ hA).at_source_type hΓ HE.defeq.hasType.2)⟩
  | etaBoth hf hg _ ih =>
    obtain ⟨_, hPi⟩ := hf.isType henv hΓ
    obtain ⟨⟨u, hA⟩, _⟩ := hPi.forallE_inv henv
    obtain ⟨_, HB⟩ := ih ⟨hΓ, u, hA⟩
    have HE := TypedComputationEq.eta heq hs hΓ hf
    have HL := (HB.lam_body hΓ hA).at_source_type hΓ HE.defeq.hasType.2
    have HR := (TypedComputationEq.eta heq hs hΓ hg).symm.at_source_type hΓ HL.defeq.hasType.2
    exact ⟨_, (HE.trans HL).trans HR⟩
  | proofIrrel hP ha hb => exact ⟨_, .proof_irrel hP ha hb⟩

/-- Normal equality produces a chain at every actual source assignment. -/
theorem TypedComputationEq.of_normal
    (heq : env.HasCanonicalEq) (hs : D.Sound env univs)
    (hΓ : OnCtx Γ (env.IsType univs)) (ht : env.HasType univs Γ a A)
    (H : NormalEqF mode Γ a b) : TypedComputationEq D Γ a b A := by
  obtain ⟨_, H⟩ := H
  obtain ⟨_, HC⟩ := normal_computation_chain_exists heq hs hΓ H
  exact HC.at_source_type hΓ ht

end Lean4Lean.VEnv.Strengthening
