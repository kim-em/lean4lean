import Lean4Lean.Theory.Typing.Strengthening.ProofErasureStaticStructureBetaRecovery
import Lean4Lean.Theory.Typing.Strengthening.ProofErasureStaticStructureLambdaResidual
import Lean4Lean.Theory.Typing.Strengthening.ProofErasureEtaFunctionResidual
import Lean4Lean.Theory.Typing.Strengthening.ProofErasureStaticStructureEtaSquares

/-! # Head beta with retained native cut certificates

Head beta may expose a lambda by substituting it for a variable. The missing
information is native recovery of each retained argument at the written cut
domain. Keeping that certificate preserves every selected native output through
finite head computations, including applications and newly created head redexes.
The certificates may use the full structure/function-eta union. They are explicit
premises, not consequences of arbitrary source typing.
-/
namespace Lean4Lean.VEnv.Strengthening
open _root_.Lean4Lean _root_.Lean4Lean.VExpr Params ProofShape
open private beta_eq from Lean4Lean.Theory.Typing.Strengthening.ProofErasureBeta
open private isProof_congr from Lean4Lean.Theory.Typing.Strengthening.ProofErasurePrimitives
open private empty_compute_beta from Lean4Lean.Theory.Typing.Strengthening.ProofErasureScopedComparison
variable [Params] {D : PureObservation.Definitions}

/-- Finite head beta computation retaining native evidence at every contracted
cut. Only retained arguments require recovery. Reduction in function position
and sequentially created head redexes are included; arbitrary argument or binder
computation is not built into this relation. -/
inductive NativeHeadBeta (D : PureObservation.Definitions) (Γ : List VExpr) :
    VExpr → VExpr → Prop where
  | refl : NativeHeadBeta D Γ e e
  | beta : env.HasType univs Γ A (.sort u) → env.HasType univs (A :: Γ) b B →
      env.HasType univs Γ x A →
      (¬ IsProof Γ x → ScopedTypeRecovery (ErasedStaticStructureEtaExpansionUnion D)
        (proofEraseCtx Γ) (proofErase Γ x) (proofErase Γ A)) →
      NativeHeadBeta D Γ (.app (.lam A b) x) (b.inst x)
  | app : NativeHeadBeta D Γ f f' → NativeHeadBeta D Γ (.app f x) (.app f' x)
  | trans : NativeHeadBeta D Γ e e' → NativeHeadBeta D Γ e' e'' → NativeHeadBeta D Γ e e''

/-- Forgetting native certificates gives an ordinary finite beta path. -/
theorem NativeHeadBeta.beta_path (H : NativeHeadBeta D Γ e e') : VExpr.BetaRed e e' := by
  induction H with
  | refl => exact .refl
  | beta => exact .beta
  | app _ ih => exact .app ih .refl
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- A typed identity wrapper is a certified cut whenever its annotation is
recovered from the wrapped argument. The argument need not be a literal lambda. -/
theorem NativeHeadBeta.identity
    (hΓ : OnCtx Γ (env.IsType univs)) (hx : env.HasType univs Γ x A)
    (HR : ¬ IsProof Γ x → ScopedTypeRecovery (ErasedStaticStructureEtaExpansionUnion D)
      (proofEraseCtx Γ) (proofErase Γ x) (proofErase Γ A)) :
    NativeHeadBeta D Γ (.app (.lam A (.bvar 0)) x) x := by
  obtain ⟨_, hA⟩ := hx.isType henv hΓ
  simpa only [VExpr.inst, VExpr.instVar, Nat.lt_irrefl, ↓reduceIte, Nat.sub_self,
    VExpr.liftN_zero] using
    (NativeHeadBeta.beta hA (show env.HasType univs (A :: Γ) (.bvar 0) A.lift from .bvar .zero) hx HR)

/-- Every actual native identity expansion reconstructs a typed wrapper whose
contraction has the required certificate. Thus retaining cut provenance imposes
no additional condition on identity expansions already generated by the union. -/
theorem native_identity_expansion_head_beta
    (heq : env.HasCanonicalEq) (hs : D.Sound env univs)
    (hΓ : OnCtx Γ (env.IsType univs)) (ht : env.HasType univs Γ e T)
    (R : NativeIdentityExpansion (ErasedStaticStructureEtaExpansionUnion D)
      (proofEraseCtx Γ) (proofErase Γ e) out) :
    ∃ expanded, env.IsDefEq univs Γ expanded e T ∧ proofErase Γ expanded = out ∧
      NativeHeadBeta D Γ expanded e := by
  cases R with
  | intro RN =>
    obtain ⟨A, heA, EA⟩ := proofErase_scoped_typeRecovery_replay
      (erased_static_structure_eta_expansion_union_descent heq hs) hΓ ht RN
    have hn : ¬ IsProof Γ e := fun hp => RN.ne_proof (proofErase_eq_proof.2 hp)
    refine ⟨.app (.lam A (.bvar 0)) e,
      ((nativeIdentityExpansion_equal heA).symm.toU.of_l henv hΓ ht).symm, ?_, ?_⟩
    · rw [proofErase_nativeIdentityExpansion hΓ heA hn, EA]
    · exact NativeHeadBeta.identity hΓ heA (fun _ => EA ▸ RN)

/-- Every selected native type survives certified head computation exactly.
No common-reduct or confluence assumption is used. -/
theorem NativeHeadBeta.recovery
    (heq : env.HasCanonicalEq) (hs : D.Sound env univs)
    (hΓ : OnCtx Γ (env.IsType univs)) (ht : env.HasType univs Γ e T)
    (H : NativeHeadBeta D Γ e e')
    (RN : ScopedTypeRecovery (ErasedStaticStructureEtaExpansionUnion D) (proofEraseCtx Γ)
      (proofErase Γ e) out) :
    ScopedTypeRecovery (ErasedStaticStructureEtaExpansionUnion D) (proofEraseCtx Γ)
      (proofErase Γ e') out := by
  induction H generalizing T out with
  | refl => exact RN
  | beta hA hb hx HR => exact static_structure_root_beta_native_recovery heq hs hΓ hA hb hx HR RN
  | @app f f' x H ih =>
    obtain ⟨A, B, hf, hx⟩ := ht.app_inv henv hΓ
    have hn : ¬ IsProof Γ (.app f x) := fun hp => RN.ne_proof (proofErase_eq_proof.2 hp)
    have HE := beta_eq hΓ ht (H.beta_path.app .refl)
    have hn' : ¬ IsProof Γ (.app f' x) := by
      intro hp
      exact hn ((isProof_congr hΓ HE).2 hp)
    rw [show proofErase Γ (.app f x) = .app _ _ from if_neg hn] at RN
    obtain ⟨X, Y, RF, RC⟩ := RN.app_origin
    rw [show proofErase Γ (.app f' x) = .app _ _ from if_neg hn']
    exact (ScopedTypeRecovery.app (ih hf RF)).convert RC
  | trans H₁ _ ih₁ ih₂ =>
    exact ih₂ (beta_eq hΓ ht H₁.beta_path).hasType.2 (ih₁ ht RN)

/-- Native eta commutes with certified head beta even when the result has not
exposed a lambda. The residual eta uses exactly the original selected Pi and
domain sort; the other residual is beta only. -/
theorem NativeHeadBeta.eta_residual
    (heq : env.HasCanonicalEq) (hs : D.Sound env univs)
    (hΓ : OnCtx Γ (env.IsType univs)) (ht : env.HasType univs Γ e T)
    (H : NativeHeadBeta D Γ e e')
    (RE : NativeEtaExpansion (ErasedStaticStructureEtaExpansionUnion D)
      (proofEraseCtx Γ) (proofErase Γ e) expanded) :
    ∃ shared, NativeEtaExpansion (ErasedStaticStructureEtaExpansionUnion D)
        (proofEraseCtx Γ) (proofErase Γ e') shared ∧
      ProofShape.BetaRed expanded shared := by
  cases RE with
  | intro RN SD =>
    exact ⟨_, .intro (H.recovery heq hs hΓ ht RN) SD,
      .lam .refl (.app (proofErase_beta_forward hΓ ht H.beta_path).liftN .refl)⟩

/-- Identity expansion has the same commuting residual. Its annotation stays
fixed because certified head beta preserves the selected type exactly. -/
theorem NativeHeadBeta.identity_residual
    (heq : env.HasCanonicalEq) (hs : D.Sound env univs)
    (hΓ : OnCtx Γ (env.IsType univs)) (ht : env.HasType univs Γ e T)
    (H : NativeHeadBeta D Γ e e')
    (RE : NativeIdentityExpansion (ErasedStaticStructureEtaExpansionUnion D)
      (proofEraseCtx Γ) (proofErase Γ e) expanded) :
    ∃ shared, NativeIdentityExpansion (ErasedStaticStructureEtaExpansionUnion D)
        (proofEraseCtx Γ) (proofErase Γ e') shared ∧
      ProofShape.BetaRed expanded shared := by
  cases RE with
  | intro RN =>
    exact ⟨_, .intro (H.recovery heq hs hΓ ht RN),
      .app .refl (proofErase_beta_forward hΓ ht H.beta_path)⟩

/-- Masked structure eta also commutes with certified head beta. The selected
family, universe instance, parameters and proof-field mask are retained. Only
the major in data projections follows the beta residual. -/
theorem NativeHeadBeta.structure_residual
    (heq : env.HasCanonicalEq) (hs : D.Sound env univs)
    (hΓ : OnCtx Γ (env.IsType univs)) (ht : env.HasType univs Γ e T)
    (H : NativeHeadBeta D Γ e e')
    (RE : NativeMaskedStructureExpansion (ErasedStaticStructureEtaExpansionUnion D)
      (proofEraseCtx Γ) (proofErase Γ e) expanded) :
    ∃ shared, NativeMaskedStructureExpansion (ErasedStaticStructureEtaExpansionUnion D)
        (proofEraseCtx Γ) (proofErase Γ e') shared ∧
      ProofShape.BetaRed expanded shared := by
  cases RE with
  | intro hi hx ha hp RN =>
    refine ⟨_, .intro hi hx ha hp (H.recovery heq hs hΓ ht RN), ?_⟩
    apply empty_compute_beta
    exact (nativeStructureOutput_compute
      (Lean4Lean.List.Forall₂.rfl (fun _ _ => ScopedCompute.refl))
      (ScopedCompute.beta (Step := fun _ _ _ => False) (Δ := proofEraseCtx Γ)
        (proofErase_beta_forward hΓ ht H.beta_path))).core_forget

/-- If certified head computation exposes a lambda, its displayed domain
computes to every previously selected native Pi domain. This includes lambdas
created by substituting into a variable head, unlike syntactic lambda readout. -/
theorem NativeHeadBeta.lambda_domain
    (heq : env.HasCanonicalEq) (hs : D.Sound env univs)
    (hΓ : OnCtx Γ (env.IsType univs)) (ht : env.HasType univs Γ e T)
    (H : NativeHeadBeta D Γ e (.lam A b))
    (RN : ScopedTypeRecovery (ErasedStaticStructureEtaExpansionUnion D) (proofEraseCtx Γ)
      (proofErase Γ e) (.forallE X Y)) :
    ScopedCompute (ErasedStaticStructureEtaExpansionUnion D) (proofEraseCtx Γ)
      (proofErase Γ A) X := by
  have R := H.recovery heq hs hΓ ht RN
  have hl := (beta_eq hΓ ht H.beta_path).hasType.2
  obtain ⟨⟨_, hA⟩, _, hb⟩ := hl.lam_inv henv hΓ
  have hn : ¬ IsProof Γ (.lam A b) := fun hp => R.ne_proof (proofErase_eq_proof.2 hp)
  rw [show proofErase Γ (.lam A b) = .lam _ _ from if_neg hn] at R
  exact static_structure_lambda_native_domain_origin heq hs hΓ hA hb R

/-- Native eta and a finite certified head computation to a lambda have a
common reduct. The short branch changes only the exposed domain; the eta branch
restores the original body by beta. Every native guard may have arbitrary finite
depth. No type-fork joining, native coverage, or normalization is assumed. -/
theorem NativeHeadBeta.eta_square
    (heq : env.HasCanonicalEq) (hs : D.Sound env univs)
    (hΓ : OnCtx Γ (env.IsType univs)) (ht : env.HasType univs Γ e T)
    (H : NativeHeadBeta D Γ e (.lam A b))
    (RE : NativeEtaExpansion (ErasedStaticStructureEtaExpansionUnion D)
      (proofEraseCtx Γ) (proofErase Γ e) expanded) :
    ∃ X, ScopedCompute (ErasedStaticStructureEtaExpansionUnion D) (proofEraseCtx Γ)
        (proofErase Γ (.lam A b)) (.lam X (proofErase (A :: Γ) b)) ∧
      ProofShape.BetaRed expanded (.lam X (proofErase (A :: Γ) b)) := by
  cases RE with
  | intro RN SD =>
    have R := H.recovery heq hs hΓ ht RN
    have hn : ¬ IsProof Γ (.lam A b) := fun hp => R.ne_proof (proofErase_eq_proof.2 hp)
    have EL : proofErase Γ (.lam A b) = .lam (proofErase Γ A) (proofErase (A :: Γ) b) := if_neg hn
    have RB := proofErase_beta_forward hΓ ht H.beta_path
    rw [EL] at RB
    have RR := proofErase_native_eta_function_lambda_residual
      (Source := fun _ => fun _ _ => False)
      (Target := fun _ => fun _ _ => False)
      (erased_static_structure_eta_expansion_union_descent heq hs)
      (by intro Γ Γ' n k e T out hΓ hΓ' W ht h; exact h.elim)
      (fun h _ => h.elim) hΓ ht RN SD (ScopedCompute.beta RB)
    exact ⟨_, by rw [EL]; exact .lam (H.lambda_domain heq hs hΓ ht RN) .refl,
      empty_compute_beta RR.core_forget⟩

end Lean4Lean.VEnv.Strengthening
