import Lean4Lean.Theory.Typing.Strengthening.ProofErasurePiInertNestedEtaMinimum
import Lean4Lean.Theory.Typing.Strengthening.ProofErasureScopedContextConversion

/-! # Concrete continuation frames for the eta minimum induction

The terminal output, typed endpoint substitutions, and retained lambdas stay
explicit. Eta descent preserves this finite frame structure and produces a
typed source with a strictly smaller combined minimum. Forcing a useful root
or bypassing a component-only body history still remains to be proved.
-/
namespace Lean4Lean.VEnv.Strengthening
open _root_.Lean4Lean _root_.Lean4Lean.VExpr Params ProofShape PureObservation
variable [Params]

/-- The actual finite continuation forms generated by eta descent. Application
frames retain ordinary typed substitutions. Retained lambda frames keep their
original domain sort, the counted annotation path, and the identity context
interpretation from the original binder to the displayed annotation. These
are structural witnesses, not closure assumptions for arbitrary predicates. -/
inductive PiInertContinuationFrames (D : Definitions) (Ω : List ProofShape) (out : ProofShape) :
    List ProofShape → (ProofShape → Nat → Prop) → Prop where
  | terminal : PiInertContinuationFrames D Ω out Ω (fun e k => e = out ∧ k = 0)
  | application : ContextSubstitution Δ Θ τ → PiInertContinuationFrames D Ω out Θ K →
      PiInertContinuationFrames D Ω out Δ (PiInertApplicationContinuation D Θ τ args K)
  | retained : DomainSort Δ A u → ScopedComputeCount (PiInertStage D n) cd Δ A A' →
      ContextSubstitution (A :: Δ) (A' :: Δ) ProofShape.Subst.id →
      PiInertContinuationFrames D Ω out Δ K →
      PiInertContinuationFrames D Ω out (A :: Δ)
        (fun body k => K (ProofShape.mkApps (.lam A' body) args) k)

/-- Pointwise equivalent presentations of the same continuation retain its
frame witness. This changes no computation, scope, endpoint, or count. -/
theorem PiInertContinuationFrames.congr
    (H : PiInertContinuationFrames D Ω out Δ K)
    (E : ∀ e k, K e k ↔ K' e k) : PiInertContinuationFrames D Ω out Δ K' := by
  have EK : K = K' := funext fun e => funext fun k => propext (E e k)
  exact EK ▸ H

/-- A typed instantiation and an arbitrary-stage application suffix form one
concrete frame ending at the fixed terminal output. -/
theorem PiInertContinuationFrames.inst
    (W : ContextSubstitution (A :: Δ) Δ (ProofShape.Subst.one x)) :
    PiInertContinuationFrames D Δ out (A :: Δ)
      (fun endpoint k => ∃ later, ScopedComputeCount (PiInertStage D later) k Δ
        (ProofShape.mkApps (endpoint.inst x) args) out) := by
  apply (PiInertContinuationFrames.application (D := D) (out := out) (args := args) W .terminal).congr
  intro endpoint k
  constructor
  · rintro ⟨later, cs, endpoint', ck, hcost, R, rfl, rfl⟩
    have Ec : cs = k := by omega
    subst cs
    exact ⟨later, by simpa only [ProofShape.inst_eq_subst, ProofShape.Subst.liftN] using R⟩
  · rintro ⟨later, R⟩
    refine ⟨later, k, out, 0, by omega, ?_, rfl, rfl⟩
    simpa only [ProofShape.inst_eq_subst, ProofShape.Subst.liftN] using R

/-- A typed current source and its concrete continuation have the displayed
minimum total primitive count. Competitors may vary both the body endpoint and
all finite computation stages, while the actual frame structure stays fixed. -/
def PiInertContinuationMinimum (D : Definitions) (Ω : List ProofShape) (out : ProofShape)
    (Δ : List ProofShape) (source : ProofShape) (cost : Nat) : Prop :=
  ∃ K n cb ck endpoint, PiInertContinuationFrames D Ω out Δ K ∧
    TypedSource Δ source ∧ ScopedComputeCount (PiInertStage D n) cb Δ source endpoint ∧
    K endpoint ck ∧ cb+ck = cost ∧
    ∀ later j endpoint' k, ScopedComputeCount (PiInertStage D later) j Δ source endpoint' →
      K endpoint' k → cost ≤ j+k

/-- The retained annotation path supplies an ordinary identity context
interpretation for its lambda frame. This transports actual typings only;
it does not assert transport of guarded computations across context conversion. -/
theorem pi_inert_retained_frame_interpretation
    (heq : env.HasCanonicalEq) (hs : D.Sound env univs)
    (SD : DomainSort Δ A u)
    (RD : ScopedComputeCount (PiInertStage D n) cd Δ A A') :
    ContextSubstitution (A :: Δ) (A' :: Δ) ProofShape.Subst.id := by
  obtain ⟨Γ, a, hΓ, EΓ, ha, Ea⟩ := SD
  obtain ⟨a', HA, EA⟩ := proofErase_scoped_compute_realize
    (ErasedScopedPrimitiveCertificateDescent.descent (pi_inert_stage_certificate_descent heq hs n))
    hΓ ha EΓ Ea RD.forget
  have WI : ContextSubstitution (proofEraseCtx (a :: Γ)) (proofEraseCtx (a' :: Γ))
      ProofShape.Subst.id := ContextSubstitution.of_defeqCtx hΓ (.succ .zero HA)
  rw [proofEraseCtx, proofEraseCtx, EΓ, Ea, EA] at WI
  intro Γ' hΓ' EΓ'
  exact WI hΓ' EΓ'

/-- The eta-cut minimum preserves concrete frames in both branches. A
surviving lambda adds a retained frame with its annotation computation; a
consumed lambda adds the actual typed instantiation/application frame. -/
theorem CountedEtaContinuationCut.frames
    (heq : env.HasCanonicalEq) (hs : D.Sound env univs)
    (H : CountedEtaContinuationCut D n Δ f A u args endpoint ct ck cost K)
    (HK : PiInertContinuationFrames D Ω out Δ K) :
    ∃ smaller, smaller < cost ∧
      PiInertContinuationMinimum D Ω out (A :: Δ)
        (.app (f.liftN 1) (etaArgument u)) smaller := by
  obtain ⟨SD, H⟩ := H
  rcases H with
    ⟨A', body', args', cf, ca, _, EO, _, _, HKbody, cd, cb, m, _, hsmall, HT, RD, RB, _, HM⟩ |
    ⟨body', x', xs', cb, cs, m, hsmall, HT, WI, RB, RS, HKbody, _, HM⟩
  · refine ⟨cb+ck, hsmall, (fun body k => K (ProofShape.mkApps (.lam A' body) args') k),
      m, cb, ck, body', .retained SD RD (pi_inert_retained_frame_interpretation heq hs SD RD) HK,
      HT, RB, ?_, rfl, HM⟩
    simpa only [EO] using HKbody
  · refine ⟨cb+(cs+ck), by omega,
      PiInertApplicationContinuation D Δ (ProofShape.Subst.one x') xs' K,
      m, cb, cs+ck, body', .application WI HK, HT, RB, ?_, rfl, ?_⟩
    · refine ⟨n, cs, endpoint, ck, rfl, ?_, HKbody⟩
      simpa only [ProofShape.inst_eq_subst, ProofShape.Subst.liftN] using RS
    · intro later j endpoint' k RJ RK
      have HH := HM later j endpoint' k RJ RK
      omega

/-- Eta descent is closed within the concrete continuation invariant and
strictly lowers its total minimum. No arbitrary continuation predicate is
introduced by the induction step. -/
theorem pi_inert_eta_continuation_frames
    (heq : env.HasCanonicalEq) (hs : D.Sound env univs)
    (hguard : ErasedScopedPrimitiveDescent Guard)
    (HT : TypedSource Δ (ProofShape.mkApps f args))
    (RN : ScopedTypeRecovery Guard Δ f (.forallE A B)) (SD : DomainSort Δ A u)
    (RP : ScopedComputeCount (PiInertStage D n) cp Δ original (ProofShape.mkApps f args))
    (HR : PiInertStage D n Δ f (.lam A (.app (f.liftN 1) (etaArgument u))))
    (RT : ScopedComputeCount (PiInertStage D n) ct Δ
      (ProofShape.mkApps (.lam A (.app (f.liftN 1) (etaArgument u))) args) endpoint)
    (HK : K endpoint ck) (HF : PiInertContinuationFrames D Ω out Δ K)
    (hcost : cp+1+ct+ck ≤ cost)
    (hmin : ∀ later j endpoint' k,
      ScopedComputeCount (PiInertStage D later) j Δ original endpoint' →
      K endpoint' k → cost ≤ j+k) :
    ∃ smaller, smaller < cost ∧
      PiInertContinuationMinimum D Ω out (A :: Δ)
        (.app (f.liftN 1) (etaArgument u)) smaller :=
  (pi_inert_eta_continuation_cut heq hs hguard HT RN SD RP HR RT HK hcost hmin).frames heq hs HF

/-- The actual nested Eq eta produces a smaller typed minimum with concrete
frames ending at the original whole-path output. The first enclosing frame is
the retained outer instantiation; the next is either a lambda or an application. -/
theorem CountedEtaBodySpineCut.nested_eta_frames
    (heq : env.HasCanonicalEq) (hs : D.Sound env univs)
    (hguard : ErasedScopedPrimitiveDescent Guard)
    (HT : TypedSource Δ (ProofShape.mkApps (ProofShape.mkApps (.const ``Eq.rec ls) pre) args))
    (RN : ScopedTypeRecovery Guard Δ (ProofShape.mkApps (.const ``Eq.rec ls) pre) (.forallE A B))
    (SD : DomainSort Δ A u)
    (H : CountedEtaBodySpineCut D n Δ ``Eq.rec ls pre A u args out ct (EqEtaRemainingRoot D))
    (hcost : cp+1+ct ≤ cost) :
    ∃ innerA innerU bodyLs bodyPre smaller, smaller < cost ∧
      PiInertContinuationMinimum D Δ out (innerA :: A :: Δ)
        (.app ((ProofShape.mkApps (.const ``Eq.rec bodyLs) bodyPre).liftN 1) (etaArgument innerU)) smaller := by
  obtain ⟨cb, cs, m, ls', bodyPre, bodyPending, innerA, innerU, body', x', xs', tb,
    hsmall, WI, _, HC⟩ := H.nested_eta_cut heq hs hguard HT RN SD hcost
  obtain ⟨smaller, hsmaller, HM⟩ := HC.frames heq hs (PiInertContinuationFrames.inst WI)
  exact ⟨innerA, innerU, ls', bodyPre, smaller, by omega, HM⟩

end Lean4Lean.VEnv.Strengthening
