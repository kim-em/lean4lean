import Lean4Lean.Theory.Typing.Strengthening.ProofErasureTypedComputationLiteralPrefix

/-! # Stored singleton equations from literal-prefix coverage

The equation construction supplies a typed literal constructor occurrence at its
only prefix step. Hence generic data-domain chains and type-fork joining suffice
for stored singleton equations with arbitrary dependent data indices. Actual
pattern alignment at independently supplied indices is a separate obligation.
-/
namespace Lean4Lean.VEnv.Strengthening
open _root_.Lean4Lean _root_.Lean4Lean.VExpr Params
variable [Params] {D : PureObservation.Definitions}

/-- Stored singleton equations require only the literal prefix generated by
the equation construction, not coverage of every well-typed prefix. -/
theorem TypedComputationEq.singleton_equation_of_literal_prefix
    (heq : env.HasCanonicalEq) (hs : D.Sound env univs)
    (hΓ : OnCtx Γ (env.IsType univs)) (hlookup : recursorData data.name = some data)
    (H : RecursorRegistered env data)
    (howner : data.schema.signature.constructors[index].owner = data.owner)
    (hgen : data.equation index = some equation) (hpe : env.PatEquation equation)
    (hlT : env.HasType equation.uvars [] equation.lhs equation.type)
    (hrT : env.HasType equation.uvars [] equation.rhs equation.type)
    (hw : ∀ l ∈ levels, l.WF univs) (hl : levels.length = equation.uvars)
    (hlarge : data.largeTarget = true)
    (hzero : (data.schema.sourceLevel data.owner data.levels).inst levels ≈ .zero)
    (hprefix : ∀ {Δ args program},
      data.singletonUnfolding env univs levels args = some program →
      data.LiteralSingletonPrefix env univs Δ levels args program →
      PrefixUnfold env univs recursorData Δ data.name levels args program.rhs →
      TypedComputationTrace D Δ (mkApps (.const data.name levels) args) program.rhs) :
    TypedComputationEq D Γ (equation.lhs.instL levels) (equation.rhs.instL levels)
      (equation.type.instL levels) := by
  obtain ⟨_, _, RL, RR, HN⟩ := H.zero_join_via_literal_prefix heq hΓ hlookup howner hgen hpe hlT hrT
    hw hl hlarge hzero (TypedComputationTrace D) TypedComputationTrace.refl
    (fun H H' => H.trans H') (fun H H' => H.app H') (fun H => H.wrapLams)
    TypedComputationTrace.beta hprefix
  have htL : env.HasType univs Γ (equation.lhs.instL levels) (equation.type.instL levels) :=
    (hlT.instL hw).weak0 henv.ordered
  have htR : env.HasType univs Γ (equation.rhs.instL levels) (equation.type.instL levels) :=
    (hrT.instL hw).weak0 henv.ordered
  have HL := RL hΓ htL
  have HR := RR hΓ htR
  exact (HL.trans (TypedComputationEq.of_normal heq hs hΓ HL.defeq.hasType.2 HN)).trans HR.symm

/-- All registered proposition-source singleton equations, including arbitrary
dependent data indices, have computation chains assuming type-fork joining and
the finite generic data-domain comparisons for their layout. No all-prefix
coverage premise remains. These two assumptions have not been discharged. -/
theorem TypedComputationEq.data_singleton_equation
    (heq : env.HasCanonicalEq) (hs : D.Sound env univs) (HF : TypeForkJoin D)
    (hΓ : OnCtx Γ (env.IsType univs)) (hlookup : recursorData data.name = some data)
    (H : RecursorRegistered env data)
    (howner : data.schema.signature.constructors[index].owner = data.owner)
    (hgen : data.equation index = some equation) (hpe : env.PatEquation equation)
    (hlT : env.HasType equation.uvars [] equation.lhs equation.type)
    (hrT : env.HasType equation.uvars [] equation.rhs equation.type)
    (hw : ∀ l ∈ levels, l.WF univs) (hl : levels.length = equation.uvars)
    (hlarge : data.largeTarget = true)
    (hzero : (data.schema.sourceLevel data.owner data.levels).inst levels ≈ .zero)
    (HD : ∀ S E, data.singletonLayout env levels = some S → data.propElim levels = some E →
      SingletonGenericDataDomainChains D S (data.propParams levels) E) :
    TypedComputationEq D Γ (equation.lhs.instL levels) (equation.rhs.instL levels)
      (equation.type.instL levels) := by
  apply TypedComputationEq.singleton_equation_of_literal_prefix heq hs hΓ hlookup H howner hgen hpe
    hlT hrT hw hl hlarge hzero
  intro Δ args program hg HL _ T hΔ ht
  exact TypedComputationEq.generated_literal_prefix heq hs HF hΔ hlookup H hlarge hzero hw HD hg HL ht

end Lean4Lean.VEnv.Strengthening
