import Lean4Lean.Theory.Typing.Strengthening.ProofErasureContextualInstantiationFork

/-! # Typed equality generated by erased computations

Every generating edge carries both its actual definitional equality and its
erased forward computation. Symmetry and transitivity preserve one assigned
type. Completeness for ordinary equality is not built into this relation.
-/
namespace Lean4Lean.VEnv.Strengthening
open _root_.Lean4Lean _root_.Lean4Lean.VExpr Params ProofShape
open private beta_eq from Lean4Lean.Theory.Typing.Strengthening.ProofErasureBeta
variable [Params] {D : PureObservation.Definitions}

/-- Finite typed chains of forward or backward computations. The ordinary
equality on a generating edge records its typing and soundness; an actual
computational path is also mandatory. No ordinary-equality completeness rule,
contextual congruence rule or confluence premise is included. -/
inductive TypedComputationEq (D : PureObservation.Definitions) (Γ : List VExpr) :
    VExpr → VExpr → VExpr → Prop where
  | step : env.IsDefEq univs Γ a b A →
      ScopedCompute (ErasedStaticStructureEtaExpansionUnion D) (proofEraseCtx Γ)
        (proofErase Γ a) (proofErase Γ b) → TypedComputationEq D Γ a b A
  | symm : TypedComputationEq D Γ a b A → TypedComputationEq D Γ b a A
  | trans : TypedComputationEq D Γ a b A → TypedComputationEq D Γ b c A →
      TypedComputationEq D Γ a c A

/-- Every computation chain retains its ordinary equality at its assigned type. -/
theorem TypedComputationEq.defeq (H : TypedComputationEq D Γ a b A) :
    env.IsDefEq univs Γ a b A := by
  induction H with
  | step HE _ => exact HE
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- Reflexivity needs only the actual source typing. -/
theorem TypedComputationEq.refl (ha : env.HasType univs Γ a A) : TypedComputationEq D Γ a a A :=
  .step ha .refl

/-- Assigned-type conversion retags every intermediate in the chain. -/
theorem TypedComputationEq.convert (HAB : env.IsDefEq univs Γ A B (.sort u))
    (H : TypedComputationEq D Γ a b A) : TypedComputationEq D Γ a b B := by
  induction H with
  | step HE R => exact .step (.defeqDF HAB HE) R
  | symm _ ih => exact (ih HAB).symm
  | trans _ _ ih₁ ih₂ => exact (ih₁ HAB).trans (ih₂ HAB)

/-- Equal erasures give a generating edge when the actual equation is typed. -/
theorem TypedComputationEq.of_erasure_eq (HE : env.IsDefEq univs Γ a b A)
    (E : proofErase Γ a = proofErase Γ b) : TypedComputationEq D Γ a b A :=
  .step HE (E ▸ ScopedCompute.refl)

/-- Source-typed replay reconstructs the ordinary equality of a forward
computation between two actual endpoints at the same assigned type. Thus the
soundness field on generating edges is not an additional completeness premise. -/
theorem TypedComputationEq.of_compute
    (heq : env.HasCanonicalEq) (hs : D.Sound env univs)
    (hΓ : OnCtx Γ (env.IsType univs))
    (ha : env.HasType univs Γ a A) (hb : env.HasType univs Γ b A)
    (R : ScopedCompute (ErasedStaticStructureEtaExpansionUnion D) (proofEraseCtx Γ)
      (proofErase Γ a) (proofErase Γ b)) : TypedComputationEq D Γ a b A := by
  obtain ⟨c, HE, Ec⟩ := proofErase_scoped_compute_realize
    (erased_static_structure_eta_expansion_union_descent heq hs) hΓ ha rfl rfl R
  obtain ⟨u, hA⟩ := ha.isType henv hΓ
  obtain ⟨n, HN⟩ := (proofErase_reflect hΓ HE.hasType.2 hb Ec).1 ⟨_, hA⟩
  exact .step (HE.trans ((HN.defeq hΓ).of_l henv hΓ HE.hasType.2)) R

/-- Typed beta paths are generating computations. -/
theorem TypedComputationEq.of_beta (hΓ : OnCtx Γ (env.IsType univs))
    (ha : env.HasType univs Γ a A) (R : VExpr.BetaRed a b) : TypedComputationEq D Γ a b A :=
  .step (beta_eq hΓ ha R) (.beta (proofErase_beta_forward hΓ ha R))

/-- Type-only fork joining turns any typed computation chain into equality of
all type observations. This works for data chains too: only observed middle
terms, which are types, are fork roots. Completeness remains separate. -/
theorem TypedComputationEq.contextual
    (heq : env.HasCanonicalEq) (hs : D.Sound env univs) (HF : TypeForkJoin D)
    (hΓ : OnCtx Γ (env.IsType univs)) (H : TypedComputationEq D Γ a b A) :
    TypeContextJoin D Γ A a b := by
  induction H with
  | step HE R =>
    obtain ⟨u, hA⟩ := HE.hasType.1.isType henv hΓ
    intro C v hC
    exact TypeContextJoin.of_compute_join heq hs ⟨hΓ, u, hA⟩ HE.hasType.1 HE.hasType.2 R .refl hC
  | symm _ ih =>
    intro C v hC
    exact TypeContextJoin.symm ih hC
  | trans H₁ _ ih₁ ih₂ =>
    intro C v hC
    exact TypeContextJoin.trans HF hΓ H₁.defeq.hasType.2 ih₁ ih₂ hC

/-- At type endpoints, type-only fork joining gives an actual common reduct
of a typed computation chain, by using the identity type observer. -/
theorem TypedComputationEq.type_join
    (heq : env.HasCanonicalEq) (hs : D.Sound env univs) (HF : TypeForkJoin D)
    (hΓ : OnCtx Γ (env.IsType univs)) (H : TypedComputationEq D Γ a b (.sort u)) :
    ∃ shared, ScopedCompute (ErasedStaticStructureEtaExpansionUnion D) (proofEraseCtx Γ)
        (proofErase Γ a) shared ∧
      ScopedCompute (ErasedStaticStructureEtaExpansionUnion D) (proofEraseCtx Γ)
        (proofErase Γ b) shared :=
  TypeContextJoin.type_join (H.contextual heq hs HF hΓ)

/-- Arbitrary typed instantiation preserves computation chains without any
fork-joining assumption. Each generating edge is replaced by its two beta-fork
branches, traversing the first backward. Native guards are never substituted. -/
theorem TypedComputationEq.inst
    (heq : env.HasCanonicalEq) (hs : D.Sound env univs)
    (hΓ : OnCtx Γ (env.IsType univs)) (hA : env.HasType univs Γ A (.sort u))
    (hx : env.HasType univs Γ x A) (H : TypedComputationEq D (A :: Γ) e e' E) :
    TypedComputationEq D Γ (e.inst x) (e'.inst x) (E.inst x) := by
  induction H with
  | step HE R =>
    have hΓA : OnCtx (A :: Γ) (env.IsType univs) := ⟨hΓ, u, hA⟩
    obtain ⟨RL, RR⟩ := static_structure_instantiation_compute_peak heq hs hΓ hA HE.hasType.1 hx R
    rw [← proofErase_instN hΓA hx Ctx.InstN.zero HE.hasType.2] at RR
    have Hβ := IsDefEq.beta HE.hasType.1 hx
    have HEx := HE.instN henv.ordered hx Ctx.InstN.zero
    exact (TypedComputationEq.step Hβ RL).symm.trans (.step (Hβ.trans HEx) RR)
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

end Lean4Lean.VEnv.Strengthening
