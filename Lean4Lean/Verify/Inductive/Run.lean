        (recursorCanonicalVars suffix.length))
      (T.result.liftN fieldDomains.length suffix.length) := by
    simpa [outer, suffix, liftContextPrefix, recursorCanonicalVars,
      List.reverse_append,
      List.append_assoc, Nat.add_comm] using Hopened
