+      rw [hfam, RuleMajor.lvls_eq_of_equiv hlev, f6] at e6; cases e6
+    | @ruleAB _ r₂ mj₂ ci₂ _ rargs2 b₂ fs₂ f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 =>
