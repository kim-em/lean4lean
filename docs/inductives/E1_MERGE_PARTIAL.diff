+def WShape.app (f : WShape (n+1)) (a : WShape n) : WShape n := by
+  refine ⟨Shape.app f.1 a.1, ?_⟩
+  obtain ⟨⟨⟩, wf⟩ := f <;> try exact .bot
+  exact (WShapeFun.app ⟨_, wf.1⟩ _).2
