+omit [ShapeParams] in
+@[simp] theorem Shape.lift_app (le : n ≤ m) :
+    (app f a : Shape n).lift m = app (f.lift _) (a.lift _) := by
+  cases f <;> simp [app, lift, ShapeFun.lift_app le]
