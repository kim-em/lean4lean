+      simp only [List.length_append, List.length_map, VExpr.bvarRange_length]
+      exact (VExpr.ClosedN.instL_rev hclosed).instL
+    rw [VExpr.liftN_at_instOuter hclosed', List.map_append, List.map_map] at hW
