+        params.map fun p => p.liftN (s.families.size + s.constructors.size + i) := by
+      apply List.map_congr_left
+      intro p _
+      simp only [Function.comp]
+      rw [VExpr.liftN'_liftN' (Nat.zero_le _) (by omega)]
+      congr 1; simp [extra]; omega
