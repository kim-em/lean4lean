+  | @ruleAB n r₁ mj₁ ci₁ m₁ rargs1 b₁ fs₁ e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 =>
+    intro rargs2 m₂ x₁ x₂ a₁ a₂ N hc H2 le1 le2 t1 t2 ca hN d1 d2 nb1 nb2
+    have hl := hc.length_eq
+    cases H2 with
+    | bot => exact absurd (le2.trans TShape.bot_eqv.1) nb2
