+    refine hj.mono_l (Valuation.LE.push.2 ⟨.rfl, (TShape.Join.mk hc x.T).2 ⟨a1', b1'⟩⟩) |>.mono ?_
+    have ja := hy₁eq ▸ hy₂eq ▸ jf.app_l x
+    have oy_c := WShape.Compat.iff.2 ⟨_, ja.le.1, ja.le.2⟩
