+theorem Restoration.find?_of_nodup {heads : List HeadSpecialization}
+    (hnodup : (heads.map (·.auxiliary)).Nodup) {x : HeadSpecialization}
+    (hx : x ∈ heads) : heads.find? (fun y => y.auxiliary == x.auxiliary) = some x := by
+  induction heads with
+  | nil => simp at hx
+  | cons y ys ih =>
