+  | bot => exact mk TShape.bot_le' .rfl H2
+  | sort h1 =>
+    cases H2 with | bot => exact bot_r hρ (.sort h1) | sort h2
+    exact mk h1 h2 (.sort .rfl)
+  | bvar h1 =>
+    cases H2 with | bot => exact bot_r hρ (.bvar h1) | bvar h2
