+    | lam f1 f2 =>
+      exact absurd (le2.trans (f2.trans (Const.lam_le_bot_of_terminal f1
+        (.inr ⟨_, e1, e2, by simp [Rule.arity, e4, ← hl, e8]⟩)))) nb2
+    | ctor f1 f2 => exact absurd (e2.trans f1) (SemSig.Coherent.ctor_no_rule f2 e1)
