+theorem WShapeFun.app_of_mem {f : WShapeFun n} (h : (x, y) ∈ f) :
+    f.app x ≤ y ∧ y ≤ f.app x :=
+  have ⟨_, h1, h2, h3⟩ := f.app_core x
+  ⟨f.mem_mono h2 h h1, h3 _ h .rfl⟩
